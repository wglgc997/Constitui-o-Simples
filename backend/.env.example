
# Aplicacao
APP_NAME=Constituicao Simples
APP_ENV=development
DEBUG=true

# Banco de dados
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/constituicao_simples

# Frontend
CORS_ORIGINS=["http://localhost:5173"]

# Inteligencia Artificial
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# Geracao antecipada
AI_GENERATION_ENABLED=true
AI_REVIEW_ENABLED=true
AI_BATCH_SIZE=5
AI_MAX_RETRIES=3

# Publicacao
AUTO_PUBLISH_AI_CONTENT=false
